// Bootcamp LMS — Prisma schema
// PostgreSQL, designed for role-based access
// (STUDENT | INSTRUCTOR | MANAGER | ADMIN)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
 url      = env("DATABASE_URL")
 //url      = env("POSTGRES_URL_NON_POOLING")
}

// ---------- Enums ----------

// Role hierarchy (capabilities, NOT inheritance — checked explicitly per action):
//   STUDENT    — enrolls, submits work, views own progress
//   INSTRUCTOR — grades submissions for courses they teach
//   MANAGER    — manages cohorts, courses, and modules; does NOT enroll
//   ADMIN      — full access; cannot enroll either
enum Role {
  STUDENT
  INSTRUCTOR
  MANAGER
  ADMIN
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DROPPED
  SUSPENDED
}

enum ContentType {
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
  LIVE_SESSION
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
  LATE
}

enum AnnouncementAudience {
  ALL
  COHORT
  COURSE
}

// ---------- Core identity ----------

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  hashedPassword String? // null for OAuth-only accounts
  role           Role     @default(STUDENT)
  suspended      Boolean  @default(false) // account lockout — admin can suspend/activate
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  enrollments       Enrollment[]
  approvedEnrollments Enrollment[] @relation("EnrollmentApprover")
  taughtCourses     Course[]      @relation("CourseInstructor")
  managedCohorts    Cohort[]      @relation("CohortManager")
  managedCourses    Course[]      @relation("CourseManager")
  submissions       Submission[]
  quizAttempts      QuizAttempt[]
  announcements     Announcement[] @relation("AnnouncementAuthor")
  gradedSubmissions Submission[]  @relation("SubmissionGrader")
  certificates      Certificate[]
  auditLogs         AuditLog[]

  @@index([role])
  @@map("users")
}

// Auth.js v5 standard adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model EmailVerification {
  id            String   @id @default(cuid())
  email         String   @db.Text
  code          String   @unique @db.Text
  purpose       String   @default("email_verification")
  isUsed        Boolean  @default(false)
  expiresAt     DateTime
  attemptsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([email, purpose])
  @@index([email])
  @@index([expiresAt])
  @@map("email_verifications")
}

// ---------- Curriculum ----------

// A cohort is a time-boxed intake for ONE course. A course always has
// many cohorts (one per intake). Students enroll into a cohort, never
// directly into a course — the cohort is what gates access to the
// course's modules, lessons, and assessments.
//
// A cohort also carries its own delivery plan: `lessons` and `modules`
// below say what THIS intake teaches, in what order. Both are optional —
// a cohort with an empty plan simply teaches the whole course in the
// course's own order.
model Cohort {
  id        String @id @default(cuid())
  courseId  String
  name      String
  slug      String @unique
  startDate DateTime
  endDate   DateTime
  description String? @db.Text
  // Optional: a MANAGER who owns/oversees the cohort.
  managerId String?
  // Whether students may self-enroll into this cohort. Staff can always
  // enroll a student manually regardless of this flag.
  isOpen     Boolean @default(true)
  // Optional seat cap. When set, the cohort accepts no further
  // enrollments (self or staff) once it is full.
  capacity   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  manager       User?          @relation("CohortManager", fields: [managerId], references: [id], onDelete: SetNull)
  enrollments   Enrollment[]
  announcements Announcement[]
  // This intake's curriculum.
  lessons       CohortLesson[]
  modules       CohortModule[]

  @@index([courseId])
  @@index([managerId])
  @@map("cohorts")
}

model Course {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String?  @db.Text
  thumbnailUrl String?
  instructorId String
  // Optional: a MANAGER who owns/oversees the course. Managers can
  // edit any course; setting a managerId just records the owner.
  managerId    String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor   User          @relation("CourseInstructor", fields: [instructorId], references: [id])
  manager      User?         @relation("CourseManager",    fields: [managerId],    references: [id], onDelete: SetNull)
  modules      Module[]
  cohorts      Cohort[]
  enrollments  Enrollment[]
  certificates Certificate[]
  announcements Announcement[]

  @@index([instructorId])
  @@index([managerId])
  @@map("courses")
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  // Assessments hang off the MODULE, not a lesson. A module is a unit of
  // work with its own lessons; the graded evidence of that unit (what to
  // submit, what to be quizzed on) is module-level, not tied to one
  // particular lesson.
  assignments Assignment[]
  quizzes     Quiz[]
  // Which cohorts deliver this module. A module can be taught in many
  // intakes, and a cohort only teaches modules of its own course.
  cohortLinks CohortModule[]

  fileKey    String? @db.Text
  fileName   String? @db.Text
  fileSize   Int?
  fileType   String?

  @@unique([courseId, order])
  @@index([courseId])
  @@map("modules")
}

// A lesson is a single teachable item inside a module. It may carry many
// videos (recorded talks, screen recordings, demos) and may be scheduled
// into a cohort's curriculum via CohortLesson.
model Lesson {
  id          String      @id @default(cuid())
  moduleId    String
  title       String
  contentType ContentType
  content     String?     @db.Text // markdown body for ARTICLE / notes for others
  durationMin Int?
  order       Int
  isFree      Boolean     @default(false) // preview lesson
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  module      Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  videos      LessonVideo[]
  // A lesson can be scheduled into many cohorts (the same course is taught
  // in every intake), so this is a many-to-many.
  cohortLinks CohortLesson[]

  @@unique([moduleId, order])
  @@index([moduleId])
  @@map("lessons")
}

// One video attached to a lesson. A lesson may have several (a lecture
// split into parts, a talk plus a demo). Either an external `url` (Vimeo,
// YouTube, CDN) or an uploaded `fileKey` in the local store, never both.
model LessonVideo {
  id          String   @id @default(cuid())
  lessonId    String
  title       String
  description String?  @db.Text
  url         String?  @db.Text // external HTTPS URL
  // Uploaded through the local store (see lib/storage.ts).
  fileKey     String?  @db.Text
  fileName    String?  @db.Text
  fileSize    Int?
  fileType    String?
  durationMin Int?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
  @@index([lessonId])
  @@map("lesson_videos")
}

// ---------- Cohort curriculum ----------

// A cohort's ordered delivery plan: which lessons of its course this
// intake actually teaches, in what order. Cohorts that define no plan fall
// back to the whole course, so this is additive rather than mandatory.
model CohortLesson {
  id        String   @id @default(cuid())
  cohortId  String
  lessonId  String
  order     Int
  // Optional gate: the lesson becomes visible to students at/after this
  // time. Null means "available from the start of the cohort".
  releaseAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([cohortId, lessonId])
  @@unique([cohortId, order])
  @@index([lessonId])
  @@map("cohort_lessons")
}

// Which modules a cohort delivers. Modules of one course only — enforced
// by the server actions, which refuse a cross-course link.
model CohortModule {
  id        String   @id @default(cuid())
  cohortId  String
  moduleId  String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([cohortId, moduleId])
  @@unique([cohortId, order])
  @@index([moduleId])
  @@map("cohort_modules")
}

// ---------- Enrollment & progress ----------

// An enrollment is a student's seat in ONE cohort. The course is
// derived from the cohort — `courseId` is denormalized here purely so
// course-level queries ("which courses is this user active in?") stay
// a single indexed lookup instead of a join through Cohort. It is
// always written equal to `cohort.courseId` by the server actions.
model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  cohortId  String
  courseId  String
  status    EnrollmentStatus @default(PENDING)
  progress  Int              @default(0) // 0-100, derived
  enrolledAt DateTime        @default(now())
  // Set when a MANAGER/ADMIN activates a PENDING self-enrollment.
  approvedAt   DateTime?
  approvedById String?
  completedAt  DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("EnrollmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([userId, cohortId])
  @@index([userId])
  @@index([cohortId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

// Tracks completion of a specific lesson by a specific user. Source of
// truth for the Enrollment.progress percentage (recomputed on change).
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ---------- Assignments & submissions ----------

// An assignment is the graded evidence for a MODULE. Submissions hang off
// it, and the grading queue reaches the owning course via
// `assignment.module.course` (two hops, not three).
model Assignment {
  id           String   @id @default(cuid())
  moduleId     String
  title        String
  prompt       String   @db.Text
  dueDate      DateTime?
  maxScore     Int      @default(100)
  attachments  String[] // file keys for assignment materials (templates, worksheets)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([moduleId])
  @@map("assignments")
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  content      String           @db.Text
  attachments  String[]         // file URLs (S3/R2)
  status       SubmissionStatus @default(SUBMITTED)
  score        Int?
  feedback     String?          @db.Text
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?
  gradedById   String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("SubmissionGrader", fields: [gradedById], references: [id])

  @@index([assignmentId])
  @@index([userId])
  @@map("submissions")
}

// ---------- Quizzes ----------

// A quiz is module-level assessment. Questions are authored against the
// quiz; attempts are a student's scored run through it.
model Quiz {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  description String?  @db.Text
  timeLimit   Int? // seconds; null = untimed
  passingScore Int     @default(70)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module    Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([moduleId])
  @@map("quizzes")
}

model QuizQuestion {
  id        String   @id @default(cuid())
  quizId    String
  prompt    String   @db.Text
  // JSON: { choices: [{id,text}], answer: "choiceId", explanation?: string }
  payload   Json
  points    Int      @default(1)
  order     Int
  createdAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, order])
  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  // JSON: array of { questionId, choiceId }
  responses   Json
  score       Int
  passed      Boolean
  startedAt   DateTime @default(now())
  completedAt DateTime?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
  @@map("quiz_attempts")
}

// ---------- Communication ----------

model Announcement {
  id        String               @id @default(cuid())
  authorId  String
  cohortId  String?
  courseId  String?
  audience  AnnouncementAudience @default(ALL)
  title     String
  body      String               @db.Text
  createdAt DateTime             @default(now())

  author  User    @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  cohort  Cohort? @relation(fields: [cohortId], references: [id])
  course  Course? @relation(fields: [courseId], references: [id])

  @@index([authorId])
  @@map("announcements")
}

// ---------- Certificates ----------

model Certificate {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  issuedAt   DateTime @default(now())
  // SHA-256 hash of (userId|courseId|issuedAt) — used for verification URL
  hash       String   @unique
  // Optional: pointer to a generated PDF in object storage
  pdfUrl     String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("certificates")
}

// ---------- Audit ----------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // e.g. "USER_LOGIN", "GRADE_ASSIGNMENT"
  resource  String? // e.g. "submission:abc123"
  metadata  Json?
  ip        String?
  userAgent String? @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// Sliding-window rate-limit events. Prisma model for visibility; the
// rate-limit module uses $queryRaw for performance.
model RateLimitEvent {
  id        String   @id @default(cuid()) @map("id")
  key       String   @map("key")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("rate_limit_events")
}

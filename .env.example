# Database
DATABASE_URL="postgresql://lms:secret@localhost:5432/knightlead_lms?schema=public"

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-32-bytes-of-base64-random"
AUTH_URL="http://localhost:3000"
# Set when deploying behind a trusted proxy / different domain.
AUTH_TRUST_HOST="true"

# Optional OAuth providers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# File storage — Cloudinary
# Uploads go straight from the browser to Cloudinary using a signature
# minted by /api/files/upload, so they never pass through a request body
# (serverless hosts cap those at ~4.5MB). The per-file ceiling is 10MB and
# is baked into the signature — see lib/upload-config.ts.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Media-library folder uploads are filed under.
CLOUDINARY_FOLDER="knightlead"
# OPTIONAL but strongly recommended: name of a Cloudinary upload preset
# configured with `max_file_size: 10485760`, `folder: knightlead` and
# `allowed_formats`. `max_file_size` sent per-request is NOT signed, so a
# determined client could drop it; a preset IS signed, so it can't be.
CLOUDINARY_UPLOAD_PRESET=""

# Rate limiting (use Upstash in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Mail (Resend recommended; falls back to console in dev)
RESEND_API_KEY=""
MAIL_FROM="Knightlead Solutions <noreply@example.com>"

# Build-time admin bootstrap (prisma/ensure-admin.ts, run from `prebuild`).
# Set these in your deploy environment rather than relying on the committed
# defaults, which stay readable in git history.
BOOTSTRAP_ADMIN_EMAIL="admin@knightleadsolutions.com.ng"
BOOTSTRAP_ADMIN_PASSWORD="Kn1ghtL3@d"
